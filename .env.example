# ============================================================================
# Firebase — frontend (já existente; duplicado aqui para referência)
# ============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Usado por clientService.ts (se configurado, tenta deletar conta Auth
# via Cloud Function ao remover paciente).
VITE_FIREBASE_FUNCTIONS_URL=

# ============================================================================
# Stripe — frontend (público, pode ser exposto no bundle)
# ============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Stripe — backend (Netlify Functions)
# Nunca commitar estes valores. Configurar em Netlify → Site Settings →
# Environment Variables.
# ============================================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs — cada plano tem 2 preços no Stripe (mensal + anual).
# Crie os 6 price_ids no painel do Stripe e cole aqui.
STRIPE_PRICE_ID_STARTER_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_STARTER_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PLUS_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PLUS_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_ADVANCED_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_ADVANCED_YEARLY=price_xxxxxxxxxxxxxxxxxxxx

# URLs de redirect pós-checkout.
# Em dev local, use http://localhost:5173. Em prod, a URL do Netlify.
STRIPE_SUCCESS_URL=https://seu-dominio.com/checkout/sucesso?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://seu-dominio.com/assinatura

# ============================================================================
# Firebase Admin SDK — usado pelo webhook para atualizar user.plan
# no Firestore server-side. Extraia do arquivo JSON da service account
# (Firebase Console → Project Settings → Service Accounts → Generate new key).
# Atenção: FIREBASE_PRIVATE_KEY deve preservar os \n (no Netlify, cole
# a chave inteira entre aspas e os \n serão interpretados).
# ============================================================================
FIREBASE_PROJECT_ID=appnutri-d3bd4
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@appnutri-d3bd4.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
