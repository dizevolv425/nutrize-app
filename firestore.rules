rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para a coleção de usuários
    match /users/{userId} {
      // Leitura: qualquer usuário autenticado (necessário p/ buscar nutricionistas/admins).
      // Cobre também: nutricionista listando docs de suas próprias secretárias
      // (resource.data.nutritionistId == request.auth.uid).
      allow read: if request.auth != null;

      // Escrita no próprio documento.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Nutricionista pode criar doc de secretária vinculada ao seu uid.
      // request.resource.data.uid == userId garante que o doc só pode
      // ser criado no path que corresponde ao Auth uid real (previne
      // spam de docs em paths arbitrários).
      allow create: if request.auth != null
                    && request.resource.data.role == "secretary"
                    && request.resource.data.nutritionistId == request.auth.uid
                    && request.resource.data.uid == userId;

      // Nutricionista pode atualizar/deletar docs das suas secretárias.
      allow update, delete: if request.auth != null
                            && resource.data.role == "secretary"
                            && resource.data.nutritionistId == request.auth.uid;
    }

    // Dados de billing (Stripe) ficam isolados numa subcoleção para
    // que o `allow read` amplo em /users/{uid} não vaze stripeCustomerId,
    // stripeSubscriptionId, stripeSubscriptionStatus, lastPaymentFailedAt etc.
    match /users/{userId}/billing/{billingDoc} {
      // Só o próprio usuário pode ler seu billing.
      allow read: if request.auth != null && request.auth.uid == userId;
      // Escrita: só o backend via Firebase Admin SDK (webhook Stripe),
      // que ignora rules. Clientes regulares não podem escrever.
      allow write: if false;
    }
    
    // Regras para outras coleções (ajuste conforme necessário)
    match /clients/{clientId} {
      // Permite que usuários autenticados leiam e escrevam clientes
      allow read, write: if request.auth != null;
    }
    
    match /appointments/{appointmentId} {
      // Permite que usuários autenticados leiam e escrevam agendamentos
      // Para queries (list), permite se o usuário está autenticado
      // Para documentos individuais, permite leitura e escrita se autenticado
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /diets/{dietId} {
      // Permite que usuários autenticados leiam e escrevam dietas
      allow read, write: if request.auth != null;
    }
    
    match /foods/{foodId} {
      // Permite que usuários autenticados leiam alimentos (pode ser apenas leitura)
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /clientNotes/{noteId} {
      // Permite que usuários autenticados leiam e escrevam notas de clientes
      allow read, write: if request.auth != null;
    }
    
    match /clientDocuments/{documentId} {
      // Permite que usuários autenticados leiam e escrevam documentos de clientes
      allow read, write: if request.auth != null;
    }
    
    match /financialTransactions/{transactionId} {
      // Permite que nutricionistas autenticados leiam e escrevam apenas suas próprias transações
      // Verifica se o nutritionistId da transação corresponde ao usuário autenticado
      allow read: if request.auth != null && 
                   (resource == null || resource.data.nutritionistId == request.auth.uid);
      allow create: if request.auth != null && 
                     request.resource.data.nutritionistId == request.auth.uid;
      allow update, delete: if request.auth != null && 
                               resource.data.nutritionistId == request.auth.uid;
    }
    
    match /dietSubstitutions/{substitutionId} {
      // Permite criação de solicitações de substituição
      // Como clientes usam instância separada de autenticação (clientAuth),
      // permitimos criação se os dados obrigatórios estão presentes
      // A validação do clientId será feita no código da aplicação
      allow create: if request.resource.data.clientId != null &&
                     request.resource.data.nutritionistId != null &&
                     request.resource.data.status == "pending" &&
                     request.resource.data.dietId != null &&
                     request.resource.data.mealName != null &&
                     request.resource.data.originalFoodId != null &&
                     request.resource.data.reason != null;
      
      // Permite leitura de solicitações para usuários autenticados
      // Clientes podem ler suas próprias solicitações (via query com clientId)
      // Nutricionistas podem ler solicitações que pertencem a eles (via query com nutritionistId)
      allow read: if request.auth != null || resource != null;
      
      // Permite que nutricionistas atualizem solicitações que pertencem a eles
      allow update: if request.auth != null && 
                     resource != null && 
                     resource.data.nutritionistId == request.auth.uid;
      
      // Permite que nutricionistas deletem solicitações que pertencem a eles
      allow delete: if request.auth != null && 
                     resource != null && 
                     resource.data.nutritionistId == request.auth.uid;
    }
    
    match /consultations/{consultationId} {
      // Permite que usuários autenticados leiam e escrevam consultas
      allow read, write: if request.auth != null;
    }
    
    match /clientGoals/{goalId} {
      // Permite que usuários autenticados leiam e escrevam objetivos de clientes
      allow read, write: if request.auth != null;
    }
    
    // Serviços dos nutricionistas
    match /services/{serviceId} {
      // Permite leitura para qualquer usuário autenticado (para mostrar serviços disponíveis)
      allow read: if request.auth != null;
      // Permite escrita apenas para o nutricionista dono do serviço
      allow create: if request.auth != null && 
                     request.resource.data.nutritionistId == request.auth.uid;
      allow update, delete: if request.auth != null && 
                             resource.data.nutritionistId == request.auth.uid;
    }
    
    // Configurações de agenda dos nutricionistas
    match /nutritionistSchedules/{scheduleId} {
      // Permite leitura para qualquer usuário autenticado
      allow read: if request.auth != null;
      // Permite escrita apenas para o próprio nutricionista (scheduleId é o nutritionistId)
      allow write: if request.auth != null && 
                    request.auth.uid == scheduleId;
    }
    
    // Regra padrão: nega acesso a todas as outras coleções
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

